# Optional GitHub App integration. Leave every value blank for local-only mode.
# These values are server-side configuration; never place private keys or tokens
# in browser code, URLs, logs, reports, or source control.
SYNAPSEAUDIT_GITHUB_APP_ID=
SYNAPSEAUDIT_GITHUB_APP_SLUG=
SYNAPSEAUDIT_GITHUB_PRIVATE_KEY_FILE=
SYNAPSEAUDIT_GITHUB_CALLBACK_URL=

# Optional Phase 2 scan budgets. Values below are the safe defaults.
SYNAPSEAUDIT_SCAN_MAX_TREE_ENTRIES=10000
SYNAPSEAUDIT_SCAN_MAX_SUPPORTED_FILES=20
SYNAPSEAUDIT_SCAN_MAX_FILE_BYTES=1048576
SYNAPSEAUDIT_SCAN_MAX_TOTAL_BYTES=8388608
SYNAPSEAUDIT_SCAN_MAX_DURATION_SECONDS=30
SYNAPSEAUDIT_SCAN_MAX_HTTP_RESPONSE_BYTES=2097152
SYNAPSEAUDIT_SCAN_MAX_API_PAGES=10
SYNAPSEAUDIT_SCAN_MAX_API_REQUESTS=40
SYNAPSEAUDIT_SCAN_MAX_SKIPPED_DETAILS=100
SYNAPSEAUDIT_SCAN_MAX_CONCURRENT=4
SYNAPSEAUDIT_SCAN_MAX_ANALYSIS_SECONDS=5
SYNAPSEAUDIT_SCAN_MAX_YAML_DEPTH=64
SYNAPSEAUDIT_SCAN_MAX_YAML_EVENTS=20000
SYNAPSEAUDIT_SCAN_MAX_YAML_ALIASES=128
SYNAPSEAUDIT_SCAN_MAX_YAML_SCALAR_CHARS=1048576
SYNAPSEAUDIT_SCAN_MAX_YAML_COLLECTION_ITEMS=2000
SYNAPSEAUDIT_SCAN_MAX_SERVICES=200
SYNAPSEAUDIT_SCAN_MAX_SERVICE_ITEMS=1000
